# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Environments
.env
venv/
.venv/

# Caches
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Data: the full 28MB dataset is not committed (see README for how to obtain
# it). The 5,000-row stratified sample IS committed so a fresh deploy has a
# working portfolio for the stress and concentration endpoints.
data/*.csv
!data/portfolio_sample.csv

# Generated reports
reports/*.json
reports/*.png

# Model artifacts ARE committed. The service loads the model at startup, so a
# deploy builds straight from the repository with no artifact store.
#
# Do not pin a version here. An earlier version of this file whitelisted one
# specific version directory; retraining produced a new version, the whitelist
# went stale, and the model silently stopped being committed. The deploy then
# started without a model and failed its health check.
#
# Prune old versions by deleting the directory instead. Each is about 880KB and
# only the one named by artifacts/LATEST needs to be present.

# Jupyter
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
