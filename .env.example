# Copy to .env for local overrides. Every setting has a working default, so an
# empty .env (or none at all) is a valid configuration - which is why no
# environment variables need to be set on Railway.
#
# All settings are read by src/loan_default/config.py (Settings) and use the
# LOAN_DEFAULT_ prefix. Unlike the previous version of this file, these are
# actually consumed by the code.

# --- Paths ---
# LOAN_DEFAULT_DATA_PATH=data/Loan_Default.csv
# LOAN_DEFAULT_PORTFOLIO_SAMPLE_PATH=data/portfolio_sample.csv
# LOAN_DEFAULT_ARTIFACTS_DIR=artifacts
# LOAN_DEFAULT_REPORTS_DIR=reports

# --- Model ---
# "latest" resolves through artifacts/LATEST. Pin a version to roll back.
# LOAN_DEFAULT_MODEL_VERSION=latest

# --- API ---
# LOAN_DEFAULT_LOG_LEVEL=INFO
# LOAN_DEFAULT_JSON_LOGS=true
# Comma-separated. Never "*" together with credentials.
# LOAN_DEFAULT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# LOAN_DEFAULT_MAX_BATCH_SIZE=1000

# NOTE: PORT is injected by Railway and is consumed by the start command in
# railway.toml, not by Settings.
