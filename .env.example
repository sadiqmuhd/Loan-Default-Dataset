# Copy to .env for local overrides. Every setting has a working default, so an
# empty .env (or none at all) is a valid configuration - which is why no
# environment variables need to be set on Railway.
#
# All settings are read by src/credit_risk/config.py (Settings) and use the
# CREDIT_RISK_ prefix. Unlike the previous version of this file, these are
# actually consumed by the code.

# --- Paths ---
# CREDIT_RISK_DATA_PATH=data/Loan_Default.csv
# CREDIT_RISK_PORTFOLIO_SAMPLE_PATH=data/portfolio_sample.csv
# CREDIT_RISK_ARTIFACTS_DIR=artifacts
# CREDIT_RISK_REPORTS_DIR=reports

# --- Model ---
# "latest" resolves through artifacts/LATEST. Pin a version to roll back.
# CREDIT_RISK_MODEL_VERSION=latest

# --- API ---
# CREDIT_RISK_LOG_LEVEL=INFO
# CREDIT_RISK_JSON_LOGS=true
# Comma-separated. Never "*" together with credentials.
# CREDIT_RISK_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# CREDIT_RISK_MAX_BATCH_SIZE=1000

# NOTE: PORT is injected by Railway and is consumed by the start command in
# railway.toml, not by Settings.
